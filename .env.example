# ============================================================
#  KG-KYP — Docker Compose ortam değişkenleri
#  Kullanım:  cp .env.example .env  →  değerleri doldur  →  docker compose up -d
# ============================================================

# --- Veritabanı ---
POSTGRES_USER=kgkyp
POSTGRES_PASSWORD=degistir-guclu-bir-parola
POSTGRES_DB=kgkyp

# --- Kimlik / JWT (rastgele üret: openssl rand -hex 48) ---
JWT_ACCESS_SECRET=degistir-64-karakter-rastgele
JWT_REFRESH_SECRET=degistir-baska-64-karakter-rastgele
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Hassas veri şifreleme (openssl rand -base64 32) ---
ENCRYPTION_KEY=degistir-32-byte-base64-anahtar

# --- İlk kurulum: admin kullanıcı seed'i (ilk açılışta bir kez) ---
SEED_ON_START=true
SEED_ADMIN_PASSWORD=Admin1234!

# --- Zamanlayıcılar ---
ALERT_CRON=0 8 * * *
BACKUP_CRON=0 9 * * *
BACKUP_KEEP=14

# --- Web (nginx) yayın portu ---
WEB_PORT=8080
