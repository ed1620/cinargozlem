# --- Veritabanı ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kgkyp?schema=public"

# --- Kimlik / JWT ---
JWT_ACCESS_SECRET="degistir-guclu-bir-anahtar"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="degistir-baska-guclu-bir-anahtar"
JWT_REFRESH_TTL="7d"

# --- Hassas veri şifreleme (AES-256-GCM, 32 byte hex/base64) ---
ENCRYPTION_KEY="degistir-32-byte-lik-anahtar-base64"

# --- Dosya depolama ---
UPLOAD_DIR="./storage/uploads"

# --- PDF raporları (Türkçe için Unicode TTF; assets/fonts/README.md) ---
FONT_DIR="./assets/fonts"

# --- Uyarı motoru ---
ALERT_CRON="0 8 * * *"    # her gün 08:00 (yedeklemeden önce)

# --- Otomatik yedekleme (pg_dump PATH'te olmalı) ---
BACKUP_DIR="./storage/backups"
BACKUP_CRON="0 9 * * *"   # her gün 09:00
BACKUP_KEEP=14            # tutulacak yedek sayısı

PORT=3000

# Bağlanılacak arayüz. Boş/eksikse 0.0.0.0 (Docker için gerekli).
# Yerelde API dışarı açılmasın istiyorsanız: HOST=127.0.0.1
HOST=127.0.0.1
